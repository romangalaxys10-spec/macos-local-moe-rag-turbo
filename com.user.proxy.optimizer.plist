<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.proxy.optimizer</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/d/.local/bin/python3</string>
        <string>-u</string>
        <string>/Users/d/.local/bin/proxy-stream-optimizer.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/optimizer.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/optimizer.log</string>
</dict>
</plist>
